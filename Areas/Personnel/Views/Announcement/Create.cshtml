@model PDKS.Entities.Announcement
@{
    ViewData["Title"] = "Yeni Duyuru";
}

<style>
    .form-wrapper {
        display: flex;
        justify-content: center;
        padding: 40px 0;
    }

    .premium-form-card {
        background: white;
        width: 100%;
        max-width: 750px;
        border-radius: 30px;
        padding: 50px;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.08);
        position: relative;
        overflow: hidden;
    }

        /* Tasarımsal üst bant */
        .premium-form-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: linear-gradient(90deg, #6366f1, #a855f7, #ec4899);
        }

    .form-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .form-header h3 {
            color: #0f172a;
            font-weight: 800;
            font-size: 2rem;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .form-header p {
            color: #64748b;
            font-size: 1.1rem;
        }

    .form-label {
        font-weight: 700;
        color: #1e293b;
        font-size: 1rem;
        margin-bottom: 10px;
        display: block;
    }

    .custom-input {
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px 20px;
        width: 100%;
        background: #f8fafc;
        transition: all 0.3s ease;
        font-size: 1rem;
        color: #0f172a;
    }

        .custom-input::placeholder {
            color: #94a3b8;
        }

        .custom-input:focus {
            border-color: #6366f1;
            background: white;
            outline: none;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            transform: translateY(-2px);
        }

    .btn-submit {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: white;
        border: none;
        padding: 18px;
        border-radius: 16px;
        font-weight: 700;
        width: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 20px;
        font-size: 1.1rem;
        box-shadow: 0 10px 20px -5px rgba(15, 23, 42, 0.4);
    }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px -5px rgba(15, 23, 42, 0.5);
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-top: 25px;
        color: #64748b;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
        font-size: 1rem;
    }

        .btn-back:hover {
            color: #0f172a;
            transform: translateX(-5px);
        }
</style>

<div class="form-wrapper">
    <div class="premium-form-card">
        <div class="form-header">
            <h3>Sesinizi Duyurun</h3>
            <p>Tüm personelin anında görebileceği yeni bir duyuru oluşturun.</p>
        </div>

        <form asp-action="Create" method="post">
            <div class="mb-4">
                <label class="form-label">Duyuru Başlığı</label>
                <input asp-for="Title" class="custom-input" placeholder="Örn: 2026 Yaz Dönemi İzin Kullanımları Hakkında" required autocomplete="off" />
            </div>

            <div class="mb-4">
                <label class="form-label">Duyuru İçeriği</label>
                <textarea asp-for="Content" class="custom-input" rows="8" placeholder="Duyurunun tüm detaylarını, açık ve anlaşılır bir dille buraya yazınız..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-bullhorn me-2"></i> Şirket Panosunda Yayınla
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fa-solid fa-arrow-left me-2"></i> Yayınlamadan İptal Et ve Panoya Dön
            </a>
        </form>
    </div>
</div>