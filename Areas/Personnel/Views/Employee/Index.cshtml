@model IEnumerable<PDKS.Entities.Employee>

@{
    ViewData["Title"] = "Personel Listesi";
}

<style>
    /* Premium Tablo Konteyneri */
    .table-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    /* Üst Başlık ve Arama/Buton Alanı */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title {
        color: #2b3674;
        font-weight: 800;
        font-size: 22px;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    /* Modern Arama Çubuğu */
    .search-box {
        position: relative;
        width: 320px;
    }

        .search-box i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #a3aed1;
            font-size: 15px;
        }

        .search-box input {
            width: 100%;
            padding: 12px 15px 12px 45px;
            border: 1px solid #e0e5f2;
            border-radius: 12px;
            outline: none;
            font-family: 'Inter', sans-serif;
            color: #2b3674;
            font-weight: 600;
            transition: all 0.3s ease;
            background-color: #f4f7fe;
        }

            .search-box input:focus {
                background-color: #ffffff;
                border-color: #4318ff;
                box-shadow: 0 0 0 3px rgba(67, 24, 255, 0.1);
            }

            .search-box input::placeholder {
                color: #a3aed1;
                font-weight: 500;
            }

    .btn-add-new {
        background-color: #4318ff;
        color: white;
        font-weight: 700;
        border-radius: 12px;
        padding: 12px 24px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
    }

        .btn-add-new:hover {
            background-color: #2b3674;
            color: white;
            transform: translateY(-2px);
        }

    /* Modern Tablo Tasarımı */
    .premium-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .premium-table th {
            color: #8f9bba;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            padding: 0 20px 10px 20px;
            border: none;
        }

        .premium-table tbody tr {
            background-color: #f4f7fe;
            transition: transform 0.2s ease;
        }

            .premium-table tbody tr:hover {
                transform: scale(1.01);
                box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            }

        .premium-table td {
            padding: 18px 20px;
            color: #2b3674;
            font-weight: 600;
            font-size: 15px;
            border: none;
            vertical-align: middle;
        }

        .premium-table tbody tr td:first-child {
            border-radius: 15px 0 0 15px;
        }

        .premium-table tbody tr td:last-child {
            border-radius: 0 15px 15px 0;
        }

    /* Profil Avatarı */
    .employee-profile {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background-color: #4318ff;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
    }

    .emp-name {
        font-weight: 800;
        color: #2b3674;
        margin-bottom: 2px;
    }

    .emp-email {
        font-size: 13px;
        color: #a3aed1;
        font-weight: 500;
    }

    /* Departman Rozeti */
    .dept-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #2b3674;
        font-size: 13px;
        font-weight: 600;
        background: #e0e5f2;
        padding: 5px 12px;
        border-radius: 8px;
    }

    /* Durum Rozetleri */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-active {
        background-color: #e6fced;
        color: #05cd99;
    }

    .status-passive {
        background-color: #fff4e5;
        color: #ff9f43;
    }

    /* İşlem Butonları */
    .action-btn {
        background: white;
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #a3aed1;
        transition: 0.3s;
        cursor: pointer;
        margin-right: 5px;
    }

        .action-btn.edit:hover {
            color: #4318ff;
            background: #e0e5f2;
        }

        .action-btn.delete:hover {
            color: #e3342f;
            background: #fbeee8;
        }

        .action-btn.info:hover {
            color: #0984e3;
            background: #e3f2fd;
        }
</style>

<div class="table-card">

    <div class="page-header">
        <h2 class="page-title">Personel Listesi</h2>
        <div class="header-actions">
            <!-- Arama Çubuğu -->
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="liveSearchInput" placeholder="Personel ara (İsim veya Soyisim)...">
            </div>

            <a asp-area="Personnel" asp-controller="Employee" asp-action="Create" class="btn-add-new">
                <i class="fa-solid fa-plus"></i> Yeni Personel
            </a>
        </div>
    </div>

    <table class="premium-table">
        <thead>
            <tr>
                <th>Personel</th>
                <th>TC Kimlik No</th>
                <th>Departman</th>
                <th>Telefon</th>
                <th>İşe Giriş</th>
                <th>Durum</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody id="employeeTableBody">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr class="emp-row">
                        <td>
                            <div class="employee-profile">
                                <div class="avatar">
                                    @(item.FirstName.Substring(0, 1))@(item.LastName.Substring(0, 1))
                                </div>
                                <div>
                                    <div class="emp-name">@item.FirstName @item.LastName</div>
                                    <div class="emp-email">@item.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>@item.IdentityNumber</td>
                        <td>
                            @if (item.Department != null)
                            {
                                <span class="dept-badge"><i class="fa-solid fa-sitemap"></i> @item.Department.Name</span>
                            }
                            else
                            {
                                <span class="dept-badge" style="background:#f4f7fe; color:#a3aed1;"><i class="fa-solid fa-sitemap"></i> Atanmadı</span>
                            }
                        </td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.HireDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-badge status-active">Aktif</span>
                            }
                            else
                            {
                                <span class="status-badge status-passive">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <!-- DETAY BUTONU EKLENDİ -->
                            <a asp-area="Personnel" asp-controller="Employee" asp-action="Details" asp-route-id="@item.Id" class="action-btn info" title="Detay">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <a asp-area="Personnel" asp-controller="Employee" asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit" title="Düzenle">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-area="Personnel" asp-controller="Employee" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('@item.FirstName personeli silinecek. Emin misiniz?');">
                                <button type="submit" class="action-btn delete" title="Sil">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr id="noDataRow">
                    <td colspan="7" class="text-center py-5 text-muted fw-bold">
                        Sistemde henüz kayıtlı personel bulunmamaktadır.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('liveSearchInput').addEventListener('keyup', function () {
        let filter = this.value.toLocaleLowerCase('tr-TR');
        let rows = document.querySelectorAll('.emp-row');

        rows.forEach(row => {
            let nameElement = row.querySelector('.emp-name');
            if (nameElement) {
                let nameText = nameElement.textContent.toLocaleLowerCase('tr-TR');
                row.style.display = nameText.includes(filter) ? '' : 'none';
            }
        });
    });
</script>