@using Microsoft.EntityFrameworkCore
@using PDKS.Data.Contexts
@inject AppDbContext _context
@model PDKS.Entities.LeaveRequest

@{
    ViewData["Title"] = "Yeni İzin Talebi";

    // SİHİRLİ KONTROL: Giren kişi yönetici mi?
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("IK") || User.IsInRole("Mudur");

    // Giren kişinin kim olduğunu buluyoruz
    var userEmail = User.Identity.Name;
    var currentEmployee = _context.Employees.FirstOrDefault(e => e.Email == userEmail);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.02); margin-top: 20px;">

            <div style="margin-bottom: 35px; border-bottom: 2px dashed #f4f7fe; padding-bottom: 20px;">
                <h3 style="color: #2b3674; font-weight: 800; display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                    <i class="fa-solid fa-calendar-plus" style="color: #4318ff;"></i> Yeni İzin Talebi Oluştur
                </h3>
                <p style="color: #a3aed1; font-weight: 600; margin: 0; font-size: 14px;">İzin detaylarını eksiksiz bir şekilde doldurarak talebinizi iletebilirsiniz.</p>
            </div>

            <form asp-action="Create" method="post">
                <div class="row g-4">

                    <!-- 1. AKILLI PERSONEL SEÇİMİ (Senin kızdığın yerin çözümü) -->
                    <div class="col-md-6">
                        @if (isAdmin)
                        {
                            <!-- Yöneticiler herkesi seçebilir -->
                            <label style="font-weight: 800; color: #2b3674; font-size: 13px; text-transform: uppercase; margin-bottom: 8px;">Personel Seçiniz</label>
                            <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeId" style="border-radius: 12px; padding: 12px 15px; border: 2px solid #f4f7fe; font-weight: 600; color: #2b3674;">
                                <option value="">-- Personel Seçiniz --</option>
                            </select>
                        }
                        else
                        {
                            <!-- Personel sadece kendini görür, değiştiremez. ID'si gizlice server'a gönderilir. -->
                            <input type="hidden" asp-for="EmployeeId" value="@currentEmployee?.Id" />
                            <label style="font-weight: 800; color: #2b3674; font-size: 13px; text-transform: uppercase; margin-bottom: 8px;">Personel Bilgisi</label>
                            <div style="border-radius: 12px; padding: 12px 15px; background-color: #f4f7fe; border: 2px solid #f4f7fe; color: #a3aed1; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                                <i class="fa-solid fa-lock" style="font-size: 12px;"></i>
                                @currentEmployee?.FirstName @currentEmployee?.LastName
                            </div>
                        }
                    </div>

                    <!-- 2. İZİN TÜRÜ -->
                    <div class="col-md-6">
                        <label style="font-weight: 800; color: #2b3674; font-size: 13px; text-transform: uppercase; margin-bottom: 8px;">İzin Türü</label>
                        <select asp-for="LeaveType" class="form-select" style="border-radius: 12px; padding: 12px 15px; border: 2px solid #f4f7fe; font-weight: 600; color: #2b3674;">
                            <option value="Yıllık İzin">Yıllık İzin</option>
                            <option value="Ücretsiz İzin">Ücretsiz İzin</option>
                            <option value="Mazeret İzni">Mazeret İzni</option>
                            <option value="Raporlu İzin">Raporlu İzin</option>
                        </select>
                    </div>

                    <!-- 3. BAŞLANGIÇ TARİHİ -->
                    <div class="col-md-6">
                        <label style="font-weight: 800; color: #2b3674; font-size: 13px; text-transform: uppercase; margin-bottom: 8px;">Başlangıç Tarihi</label>
                        <input asp-for="StartDate" type="date" class="form-control" style="border-radius: 12px; padding: 12px 15px; border: 2px solid #f4f7fe; font-weight: 600; color: #2b3674;" required />
                    </div>

                    <!-- 4. BİTİŞ TARİHİ -->
                    <div class="col-md-6">
                        <label style="font-weight: 800; color: #2b3674; font-size: 13px; text-transform: uppercase; margin-bottom: 8px;">Bitiş Tarihi</label>
                        <input asp-for="EndDate" type="date" class="form-control" style="border-radius: 12px; padding: 12px 15px; border: 2px solid #f4f7fe; font-weight: 600; color: #2b3674;" required />
                    </div>

                    <!-- 5. AÇIKLAMA / GEREKÇE -->
                    <div class="col-12">
                        <label style="font-weight: 800; color: #2b3674; font-size: 13px; text-transform: uppercase; margin-bottom: 8px;">Gerekçe / Açıklama</label>
                        <textarea asp-for="Reason" class="form-control" rows="4" placeholder="İzin gerekçenizi buraya detaylıca yazabilirsiniz..." style="border-radius: 12px; padding: 15px; border: 2px solid #f4f7fe; font-weight: 500; color: #2b3674; resize: none;"></textarea>
                    </div>

                    <!-- BUTONLAR -->
                    <div class="col-12 d-flex justify-content-end align-items-center mt-4 pt-3" style="border-top: 2px dashed #f4f7fe;">
                        <a asp-action="Index" style="color: #a3aed1; font-weight: 800; text-decoration: none; margin-right: 25px; transition: 0.2s;" onmouseover="this.style.color='#2b3674'" onmouseout="this.style.color='#a3aed1'">
                            İptal Et
                        </a>
                        <button type="submit" style="background: linear-gradient(135deg, #4318ff 0%, #8e33ff 100%); color: white; border: none; padding: 14px 35px; border-radius: 14px; font-weight: 800; transition: all 0.3s ease; box-shadow: 0 10px 20px rgba(67, 24, 255, 0.2);">
                            <i class="fa-solid fa-paper-plane" style="margin-right: 8px;"></i> Talebi Gönder
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>