@model IEnumerable<PDKS.Entities.OvertimeRequest>

@{
    ViewData["Title"] = "Mesai Takibi";
}

@if (User.IsInRole("Admin") || User.IsInRole("IK") || User.IsInRole("Mudur"))
{
    <partial name="_AdminOvertimeIndex" model="Model" />
}
else
{
    <partial name="_PersonnelOvertimeIndex" model="Model" />
}