@model IEnumerable<PDKS.Entities.OvertimeRequest>
@{
    ViewData["Title"] = "Mesai Takibi";
}

<style>
    /* Premium Dashboard Stilleri */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title {
        color: #2b3674;
        font-weight: 800;
        font-size: 1.8rem;
        margin: 0;
    }

    .btn-premium {
        background: linear-gradient(135deg, #4318ff 0%, #865cff 100%);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(67, 24, 255, 0.2);
    }

        .btn-premium:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 6px 20px rgba(67, 24, 255, 0.4);
        }

    .stat-card-group {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-left: 5px solid transparent;
    }

        .stat-card.pending {
            border-left-color: #f59e0b;
        }

        .stat-card.approved {
            border-left-color: #10b981;
        }

        .stat-card.total {
            border-left-color: #4318ff;
        }

    .stat-title {
        color: #a3aed1;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .stat-value {
        color: #2b3674;
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .pending-icon {
        background: #fffbeb;
        color: #f59e0b;
    }

    .approved-icon {
        background: #ecfdf5;
        color: #10b981;
    }

    .total-icon {
        background: #f4f7fe;
        color: #4318ff;
    }

    .table-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        .custom-table thead th {
            color: #a3aed1;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            padding: 0 15px 10px 15px;
            border: none;
        }

        .custom-table tbody tr {
            background: #f8f9fe;
            transition: all 0.2s ease;
        }

            .custom-table tbody tr:hover {
                transform: scale(1.01);
                box-shadow: 0 5px 10px rgba(0,0,0,0.05);
            }

        .custom-table tbody td {
            padding: 15px;
            border: none;
            color: #2b3674;
            font-weight: 500;
            vertical-align: middle;
        }

            .custom-table tbody td:first-child {
                border-radius: 12px 0 0 12px;
            }

            .custom-table tbody td:last-child {
                border-radius: 0 12px 12px 0;
            }

    .badge-status {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-pending {
        background: #fffbeb;
        color: #f59e0b;
    }

    .badge-approved {
        background: #ecfdf5;
        color: #10b981;
    }

    .badge-rejected {
        background: #fef2f2;
        color: #ef4444;
    }

    .action-btn {
        background: white;
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        margin-right: 5px;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .btn-approve {
        color: #10b981;
    }

        .btn-approve:hover {
            background: #10b981;
            color: white;
        }

    .btn-reject {
        color: #f59e0b;
    }

        .btn-reject:hover {
            background: #f59e0b;
            color: white;
        }

    .btn-delete {
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
        }
</style>

<div class="dashboard-header">
    <h2 class="page-title">Mesai Takip Merkezi</h2>
    <a asp-action="Create" class="btn-premium">
        <i class="fa-solid fa-plus"></i> Yeni Mesai Ekle
    </a>
</div>

<!-- İstatistik Kartları -->
<div class="stat-card-group">
    <div class="stat-card total">
        <div>
            <div class="stat-title">Toplam Talep</div>
            <h3 class="stat-value">@Model.Count()</h3>
        </div>
        <div class="stat-icon total-icon"><i class="fa-solid fa-list-ol"></i></div>
    </div>
    <div class="stat-card pending">
        <div>
            <div class="stat-title">Bekleyen Onaylar</div>
            <h3 class="stat-value">@Model.Count(x => x.Status == "Bekliyor")</h3>
        </div>
        <div class="stat-icon pending-icon"><i class="fa-solid fa-hourglass-half"></i></div>
    </div>
    <div class="stat-card approved">
        <div>
            <div class="stat-title">Onaylananlar</div>
            <h3 class="stat-value">@Model.Count(x => x.Status == "Onaylandı")</h3>
        </div>
        <div class="stat-icon approved-icon"><i class="fa-solid fa-check-double"></i></div>
    </div>
</div>

<!-- Mesai Listesi Tablosu -->
<div class="table-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color: #a3aed1;">
            <i class="fa-solid fa-folder-open mb-3" style="font-size: 3rem;"></i>
            <h5>Henüz hiç mesai talebi bulunmuyor.</h5>
        </div>
    }
    else
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Tarih</th>
                    <th>Saat Aralığı</th>
                    <th>Gerekçe</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: bold;">
                                    @(item.Employee?.FirstName?.Substring(0, 1) ?? "P")
                                </div>
                                <span style="font-weight: 700;">@item.Employee?.FirstName</span>
                            </div>
                        </td>
                        <td><i class="fa-regular fa-calendar text-primary me-2"></i> @item.RequestDate.ToString("dd MMM yyyy")</td>
                        <td><i class="fa-regular fa-clock text-primary me-2"></i> @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                        <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Reason">
                            @item.Reason
                        </td>
                        <td>
                            @if (item.Status == "Onaylandı")
                            {
                                <span class="badge-status badge-approved"><i class="fa-solid fa-check"></i> Onaylandı</span>
                            }
                            else if (item.Status == "Reddedildi")
                            {

                                <span class="badge-status badge-rejected"><i class="fa-solid fa-xmark"></i> Reddedildi</span>
                            }
                            else
                            {

                                <span class="badge-status badge-pending"><i class="fa-solid fa-spinner fa-spin-pulse"></i> Bekliyor</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end">
                                <!-- Onayla Butonu -->
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Onaylandı" />
                                    <button type="submit" class="action-btn btn-approve" title="Onayla"><i class="fa-solid fa-check"></i></button>
                                </form>
                                <!-- Reddet Butonu -->
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Reddedildi" />
                                    <button type="submit" class="action-btn btn-reject" title="Reddet"><i class="fa-solid fa-ban"></i></button>
                                </form>
                                <!-- Sil Butonu -->
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu kaydı tamamen silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="action-btn btn-delete" title="Sil"><i class="fa-regular fa-trash-can"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>