@using Microsoft.EntityFrameworkCore
@using PDKS.Data.Contexts
@inject AppDbContext _context
@model IEnumerable<PDKS.Entities.LeaveRequest>
@{
    ViewData["Title"] = "Ana Sayfa";

    // YENİ BÖLÜM İÇİN VERİLERİ ÇEKİYORUZ
    var bugun = DateTime.Today;

    var bugunHareketler = _context.Attendances
        .Include(a => a.Employee)
        .Where(a => a.Date.Date == bugun)
        .OrderByDescending(a => a.CheckInTime)
        .Take(5).ToList();

    var bekleyenMesailer = _context.OvertimeRequests
        .Include(o => o.Employee)
        .Where(o => o.Status == "Bekliyor")
        .OrderBy(o => o.RequestDate)
        .Take(4).ToList();
}

<style>
    /* --- ÜST KARTLARIN TASARIMI --- */
    .dash-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        display: flex;
        align-items: center;
        transition: transform 0.2s ease;
    }

        .dash-card:hover {
            transform: translateY(-5px);
        }

    .icon-box {
        width: 75px;
        height: 75px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .icon-box i {
            font-size: 32px;
        }

    .card-info {
        margin-left: 20px;
    }

    .card-title-text {
        font-size: 15px;
        font-weight: 700;
        color: #8f9bba;
        margin-bottom: 4px;
    }

    .card-number {
        font-size: 32px;
        font-weight: 800;
        color: #2b3674;
        margin-bottom: 4px;
        line-height: 1;
    }

    .card-trend {
        font-size: 13px;
        font-weight: 700;
    }

    /* Renk Paletleri */
    .bg-blue-light {
        background-color: #f4f7fe;
    }

    .text-blue-main {
        color: #4318ff;
    }

    .bg-green-light {
        background-color: #e6fced;
    }

    .text-green-main {
        color: #05cd99;
    }

    .bg-orange-light {
        background-color: #fff4e5;
    }

    .text-orange-main {
        color: #ff9f43;
    }

    .bg-purple-light {
        background-color: #f4e8ff;
    }

    .text-purple-main {
        color: #8e33ff;
    }

    /* --- ORTA KARTLAR (DUYURULAR & İZİNLER) TASARIMI --- */
    .content-widget {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        height: 100%;
    }

    .content-widget-dark {
        background: #0b1437;
        color: white;
    }

    .widget-title {
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .widget-title-light {
        color: #2b3674;
    }

    .widget-title-dark {
        color: #ffffff;
    }

    .list-item {
        display: flex;
        align-items: flex-start;
        padding: 18px 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .content-widget-dark .list-item {
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .list-item:last-child {
        border-bottom: none;
    }

    .avatar-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-right: 18px;
        color: #fff;
    }

    .leave-info h6 {
        font-size: 16px;
        font-weight: 800;
        margin: 0 0 5px 0;
        color: #fff;
    }

    .leave-info p {
        font-size: 14px;
        color: #a3aed1;
        margin: 0;
        font-weight: 600;
    }

    .leave-date {
        margin-left: auto;
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        text-align: right;
    }

    .view-all-link {
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        color: #4318ff;
        display: inline-block;
        margin-top: 20px;
        transition: 0.3s;
    }

        .view-all-link:hover {
            color: #2b3674;
        }

    .content-widget-dark .view-all-link {
        color: #a3aed1;
    }

        .content-widget-dark .view-all-link:hover {
            color: #fff;
        }


    /* --- 3. BÖLÜM TASARIMLARI (YENİ GİRİŞ/ÇIKIŞ VE MESAİ) --- */

    /* Tablo Tasarımı (Giriş/Çıkış) */
    .premium-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .premium-table th {
            color: #a3aed1;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            padding-bottom: 15px;
            border-bottom: 1px solid #f4f7fe;
            text-align: left;
        }

        .premium-table td {
            padding: 16px 0;
            border-bottom: 1px solid #f4f7fe;
            vertical-align: middle;
            color: #2b3674;
            font-weight: 600;
            font-size: 0.95rem;
            transition: 0.2s;
        }

        .premium-table tr:last-child td {
            border-bottom: none;
        }

        .premium-table tr:hover td {
            background-color: #fafbff;
            padding-left: 10px;
            border-radius: 8px;
        }

    /* Yuvarlak Profil İkonu (Tablo İçi) */
    .user-initial {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #f4f7fe;
        color: #4318ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1rem;
    }

    /* Saat Etiketleri */
    .time-badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }

    .time-in {
        color: #05cd99;
        background: #e6fced;
        border-color: #c3f2d7;
    }

    .time-out {
        color: #ff3d00;
        background: #ffeae6;
        border-color: #ffd0c7;
    }

    /* Mesai Kartları (Sağ Taraf Liste) */
    .ot-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px dashed #e2e8f0;
        transition: transform 0.2s ease;
    }

        .ot-item:last-child {
            border-bottom: none;
        }

        .ot-item:hover {
            transform: translateX(5px);
        }

    .ot-user {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .ot-avatar {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #fff4e5;
        color: #ff9f43;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .ot-name {
        color: #2b3674;
        font-weight: 800;
        font-size: 0.95rem;
        margin: 0 0 4px 0;
    }

    .ot-time {
        color: #a3aed1;
        font-size: 0.8rem;
        font-weight: 700;
        margin: 0;
    }

    .ot-badge {
        background: #fff4e5;
        color: #ff9f43;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.5px;
    }
</style>

<!-- ========================================== -->
<!-- 1. BÖLÜM: ÜST İSTATİSTİK KARTLARI (LİNKLİ) -->
<!-- ========================================== -->
<div class="row g-4">
    <div class="col-xl-3 col-lg-6 col-md-6">
        <a asp-area="Personnel" asp-controller="Employee" asp-action="Index" style="text-decoration: none; color: inherit; display: block;">
            <div class="dash-card">
                <div class="icon-box bg-blue-light text-blue-main"><i class="fa-solid fa-users"></i></div>
                <div class="card-info">
                    <div class="card-title-text">Toplam Personel</div>
                    <div class="card-number">@ViewBag.TotalEmployee</div>
                    <div class="card-trend text-success"><i class="fa-solid fa-arrow-trend-up"></i> Son 30 gün</div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-lg-6 col-md-6">
        <a asp-area="Personnel" asp-controller="Employee" asp-action="Index" style="text-decoration: none; color: inherit; display: block;">
            <div class="dash-card">
                <div class="icon-box bg-green-light text-green-main"><i class="fa-solid fa-user-check"></i></div>
                <div class="card-info">
                    <div class="card-title-text">Aktif Personel</div>
                    <div class="card-number">@ViewBag.ActiveEmployee</div>
                    <div class="card-trend text-success"><i class="fa-solid fa-arrow-trend-up"></i> Güncel</div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-lg-6 col-md-6">
        <a asp-area="Personnel" asp-controller="LeaveRequest" asp-action="Index" style="text-decoration: none; color: inherit; display: block;">
            <div class="dash-card">
                <div class="icon-box bg-orange-light text-orange-main"><i class="fa-solid fa-user-clock"></i></div>
                <div class="card-info">
                    <div class="card-title-text">İzinli Personel</div>
                    <div class="card-number">@ViewBag.OnLeaveEmployee</div>
                    <div class="card-trend text-danger"><i class="fa-solid fa-arrow-trend-down"></i> Bugün</div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-lg-6 col-md-6">
        <a asp-area="Personnel" asp-controller="Department" asp-action="Index" style="text-decoration: none; color: inherit; display: block;">
            <div class="dash-card">
                <div class="icon-box bg-purple-light text-purple-main"><i class="fa-solid fa-sitemap"></i></div>
                <div class="card-info">
                    <div class="card-title-text">Toplam Departman</div>
                    <div class="card-number">@ViewBag.TotalDepartment</div>
                    <div class="card-trend" style="color: #a3aed1;"><i class="fa-solid fa-minus"></i> Değişiklik yok</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. BÖLÜM: YAKLAŞAN İZİNLER VE DUYURULAR -->
<!-- ========================================== -->
<div class="row g-4 mt-2">
    <!-- Yaklaşan İzinler (DİNAMİK) -->
    <div class="col-lg-6">
        <div class="content-widget content-widget-dark">
            <div class="widget-title widget-title-dark">
                Yaklaşan İzinler
                <i class="fa-regular fa-calendar-check" style="color: #a3aed1;"></i>
            </div>
            <div class="widget-content">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="list-item">
                            <div class="avatar-icon"><i class="fa-regular fa-user"></i></div>
                            <div class="leave-info">
                                <h6>@item.Employee?.FirstName @item.Employee?.LastName</h6>
                                <p>@item.Employee?.Department?.Name</p>
                            </div>
                            <div class="leave-date">
                                @item.StartDate.ToString("dd MMMM")<br>
                                <span style="font-size: 12px; color: #a3aed1; font-weight: 500;">@item.StartDate.ToString("dddd")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted p-3">Yaklaşan izin kaydı bulunmamaktadır.</p>
                }
            </div>
            <a asp-area="Personnel" asp-controller="LeaveRequest" asp-action="Index" class="view-all-link">Tüm izin taleplerini gör &rarr;</a>
        </div>
    </div>

    <!-- DİNAMİK DUYURULAR KARTI -->
    <div class="col-lg-6">
        <div style="background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); height: 100%;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 style="color: #2b3674; font-weight: 800; margin: 0;">Duyurular</h5>
                <i class="fa-solid fa-bullhorn" style="color: #4318ff; font-size: 1.2rem;"></i>
            </div>

            @{
                var sonDuyurular = _context.Announcements.Where(a => a.IsActive).OrderByDescending(a => a.CreatedDate).Take(3).ToList();
            }

            @if (sonDuyurular != null && sonDuyurular.Any())
            {
                @foreach (var item in sonDuyurular)
                {
                    <div class="mb-4 pb-3" style="border-bottom: 1px solid #f4f7fe;">
                        <div style="color: #a3aed1; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px;">
                            @item.CreatedDate.ToString("dd MMMM yyyy")
                        </div>
                        <h6 style="color: #2b3674; font-weight: 800; margin-bottom: 8px; font-size: 1.05rem;">
                            @item.Title <span style="color: #ef4444; font-size: 0.8rem; vertical-align: middle;">●</span>
                        </h6>
                        <p style="color: #707eae; font-size: 0.95rem; margin-bottom: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Content
                        </p>
                    </div>
                }
            }
            else
            {
                <p style="color: #707eae; font-size: 0.95rem; padding: 10px 0;">Henüz yayınlanmış bir duyuru bulunmuyor.</p>
            }

            <a asp-area="Personnel" asp-controller="Announcement" asp-action="Index" style="color: #4318ff; font-weight: 700; text-decoration: none; font-size: 0.95rem; display: inline-block; margin-top: 5px;">
                Tüm duyuruları gör &rarr;
            </a>
        </div>
    </div>
</div>


<!-- ========================================== -->
<!-- 3. BÖLÜM: YENİ EKLENEN GİRİŞ/ÇIKIŞ VE MESAİ -->
<!-- ========================================== -->
<div class="row g-4 mt-2">

    <!-- Sol Taraf (Geniş): Bugünün Giriş / Çıkış Hareketleri -->
    <div class="col-lg-8">
        <div class="content-widget">
            <div class="widget-title widget-title-light">
                Bugünün Giriş/Çıkış Hareketleri
                <i class="fa-solid fa-fingerprint" style="color: #05cd99;"></i>
            </div>

            @if (bugunHareketler != null && bugunHareketler.Any())
            {
                <div class="table-responsive">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Personel</th>
                                <th>Giriş Saati</th>
                                <th>Çıkış Saati</th>
                                <th>Durum Notu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in bugunHareketler)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-initial">
                                                @(item.Employee?.FirstName?.Substring(0, 1) ?? "P")
                                            </div>
                                            <span>@item.Employee?.FirstName @item.Employee?.LastName</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.CheckInTime.HasValue)
                                        {
                                            <span class="time-badge time-in"><i class="fa-solid fa-arrow-right-to-bracket"></i> @item.CheckInTime.Value.ToString(@"hh\:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.CheckOutTime.HasValue)
                                        {
                                            <span class="time-badge time-out"><i class="fa-solid fa-arrow-right-from-bracket"></i> @item.CheckOutTime.Value.ToString(@"hh\:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td style="color: #a3aed1; font-weight: 500; font-size: 0.9rem;">
                                        @(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fa-solid fa-mug-hot mb-3" style="font-size: 2.5rem; color: #e2e8f0;"></i>
                    <p style="color: #a3aed1; font-weight: 600; margin:0;">Bugün henüz bir giriş veya çıkış hareketi kaydedilmedi.</p>
                </div>
            }
            <a asp-area="Personnel" asp-controller="Attendance" asp-action="Index" class="view-all-link">Tüm kayıtları görüntüle &rarr;</a>
        </div>
    </div>

    <!-- Sağ Taraf (Dar): Bekleyen Mesai Onayları -->
    <div class="col-lg-4">
        <div class="content-widget">
            <div class="widget-title widget-title-light">
                Onay Bekleyen Mesailer
                <i class="fa-solid fa-clock-rotate-left" style="color: #ff9f43;"></i>
            </div>

            @if (bekleyenMesailer != null && bekleyenMesailer.Any())
            {
                @foreach (var item in bekleyenMesailer)
                {
                    <div class="ot-item">
                        <div class="ot-user">
                            <div class="ot-avatar"><i class="fa-solid fa-business-time"></i></div>
                            <div>
                                <p class="ot-name">@item.Employee?.FirstName @item.Employee?.LastName</p>
                                <p class="ot-time">@item.RequestDate.ToString("dd MMM") | @item.StartTime.ToString(@"hh\:mm")-@item.EndTime.ToString(@"hh\:mm")</p>
                            </div>
                        </div>
                        <div class="ot-badge">Bekliyor</div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fa-regular fa-face-smile mb-3" style="font-size: 2.5rem; color: #e2e8f0;"></i>
                    <p style="color: #a3aed1; font-weight: 600; margin:0;">Bekleyen mesai talebi yok, harika!</p>
                </div>
            }
            <a asp-area="Personnel" asp-controller="OvertimeRequest" asp-action="Index" class="view-all-link">Mesai paneline git &rarr;</a>
        </div>
    </div>
</div>