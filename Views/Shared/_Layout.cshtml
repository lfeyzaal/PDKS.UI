<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDKS Sistemi</title>

    <!-- Google Fontu: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- İkon Seti (FontAwesome) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f7fe;
            overflow-x: hidden;
            font-size: 15px;
        }

        .dashboard-wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* Sidebar Tasarımı */
        .sidebar {
            width: 270px;
            background-color: #0b1437;
            color: white;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            z-index: 10;
        }

        .sidebar-logo {
            padding: 25px 20px;
            font-size: 1.4rem;
            font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-menu {
            padding: 20px 0;
            list-style: none;
            margin: 0;
        }

            .sidebar-menu li {
                padding: 6px 20px;
            }

            .sidebar-menu a {
                color: #a3aed1;
                text-decoration: none;
                font-weight: 500;
                display: flex;
                align-items: center;
                border-radius: 10px;
                padding: 12px 15px;
                transition: all 0.3s ease;
            }

                .sidebar-menu a:hover, .sidebar-menu a.active {
                    background-color: #4318ff;
                    color: white;
                }

            .sidebar-menu i {
                margin-right: 15px;
                font-size: 1.2rem;
                width: 25px;
                text-align: center;
            }

        /* Ana İçerik */
        .main-content {
            flex-grow: 1;
            padding: 25px 35px;
            overflow-y: auto;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: transparent;
        }

        .welcome-text h4 {
            color: #2b3674;
            font-weight: 700;
            font-size: 1.5rem;
            margin-bottom: 4px;
        }

        .welcome-text span {
            color: #707eae;
            font-size: 0.95rem;
        }

        .top-widgets {
            display: flex;
            align-items: center;
            background: white;
            padding: 10px 20px;
            border-radius: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            gap: 20px;
            color: #2b3674;
            font-weight: 500;
        }

            .top-widgets i {
                color: #4318ff;
            }

        .content-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        }
    </style>
</head>
<body>
    <div class="dashboard-wrapper">
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
        }

        <!-- SOL MENÜ -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <i class="fa-solid fa-building-user"></i> PDKS Sistemi
            </div>
            <ul class="sidebar-menu">
                <li><a href="/" class="@(currentController == "Home" ? "active" : "")"><i class="fa-solid fa-house"></i> Ana Sayfa</a></li>

                <!-- SİHİRLİ KİLİT: SADECE İK VE ADMİN GÖRÜR -->
                @if (User.IsInRole("IK") || User.IsInRole("Admin"))
                {
                    <li><a asp-area="Personnel" asp-controller="Employee" asp-action="Index" class="@(currentController == "Employee" ? "active" : "")"><i class="fa-solid fa-users"></i> Personeller</a></li>
                    <li><a asp-area="Personnel" asp-controller="Department" asp-action="Index" class="@(currentController == "Department" ? "active" : "")"><i class="fa-solid fa-sitemap"></i> Departmanlar</a></li>
                }

                <li><a asp-area="Personnel" asp-controller="LeaveRequest" asp-action="Index" class="@(currentController == "LeaveRequest" ? "active" : "")"><i class="fa-regular fa-calendar-check"></i> İzin Talepleri</a></li>
                <li><a asp-area="Personnel" asp-controller="OvertimeRequest" asp-action="Index" class="@(currentController == "OvertimeRequest" ? "active" : "")"><i class="fa-solid fa-clock"></i> <span>Mesai Takibi</span></a></li>
                <li><a asp-area="Personnel" asp-controller="Attendance" asp-action="Index" class="@(currentController == "Attendance" ? "active" : "")"><i class="fa-solid fa-fingerprint"></i> <span>Giriş / Çıkışlar</span></a></li>
                <li><a asp-area="Personnel" asp-controller="Announcement" asp-action="Index" class="@(currentController == "Announcement" ? "active" : "")"><i class="fa-solid fa-bullhorn"></i> <span>Duyurular</span></a></li>
            </ul>
        </aside>

        <!-- ANA EKRAN -->
        <main class="main-content">
            <header class="topbar">
                <div class="welcome-text">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <h4>Hoş geldiniz, @User.Identity.Name 👋</h4>
                    }
                    else
                    {
                        <h4>Hoş geldiniz 👋</h4>
                    }
                    <span>Personel takip ve yönetim sistemine hoş geldiniz.</span>
                </div>

                <div class="top-widgets">
                    <div class="d-flex align-items-center gap-2 border-end pe-3">
                        <i class="fa-regular fa-calendar"></i>
                        <span>16 Temmuz 2026, Perşembe</span>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm d-flex align-items-center gap-2" style="background-color: #ffefef; color: #e74c3c; border-radius: 10px; font-weight: 600; padding: 6px 12px; text-decoration: none; border: 1px solid #ffe1e1; transition: 0.3s;">
                            <i class="fa-solid fa-arrow-right-from-bracket" style="color: #e74c3c;"></i> Çıkış Yap
                        </a>
                    }
                </div>
            </header>

            <div class="content-card">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>